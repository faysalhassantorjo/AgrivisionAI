# ============================================================
# AgrivisionAI / PlantMD Environment Configuration
# ============================================================

# Django Security Settings
# Generate a secure key in production (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
DJANGO_SECRET_KEY=change-this-to-a-secure-secret-key-in-production

# Debug Mode: True for development, False for production
DEBUG=False

# Allowed Hosts (comma-separated list of hostnames/IPs)
ALLOWED_HOSTS=localhost,127.0.0.1,nexcure.site,69.62.77.17

# CSRF Trusted Origins (comma-separated list of origins)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://nexcure.site,https://nexcure.site,http://69.62.77.17

# Upload Limits
MAX_UPLOAD_SIZE_MB=10

# Logging
LOG_LEVEL=INFO

# Model Configuration
# Optional: Directory where ML models are stored (defaults to each app's source directory)
# MODEL_BASE_DIR=/app/models
